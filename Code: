#include <WiFi.h>

#define LED 2

String inputBuffer = "";
unsigned long bootTime = 0;

void setup() {
  Serial.begin(115200);
  pinMode(LED, OUTPUT);
  digitalWrite(LED, LOW);
  delay(2500);

  bootScreen();
  autoexec();
  bootTime = millis();
}

void bootScreen() {
  Serial.println();
  Serial.println("ES32 BIOS V1.0  (C) 2026 Espressif Systems Ltd.");
  Serial.println("CPU: ESP32 Dual-Core 240MHz");
  Serial.print("Memory Test: ");
  delay(400);
  Serial.print("320K OK");
  delay(300);
  Serial.println();
  Serial.println();
  delay(500);
  Serial.println("Initializing SPI Flash... OK");
  delay(300);
  Serial.println("Initializing Radio Subsystem... OK");
  delay(300);
  Serial.println("Loading ES-DOS 1.0...");
  delay(600);
  Serial.println();
}

void autoexec() {
  Serial.println("ES-DOS 1.0  (C) 2026 Espressif Micro Systems");
  Serial.println();
  Serial.println("Starting AUTOEXEC.BAT...");
  delay(400);
  Serial.println("PATH=C:\\ESDOS;C:\\BIN");
  delay(200);
  Serial.println("SET TEMP=C:\\TMP");
  delay(200);
  Serial.println("SET COMSPEC=C:\\ESDOS\\COMMAND.COM");
  delay(300);
  Serial.println("PROMPT $P$G");
  delay(200);
  Serial.println("C:\\ESDOS\\SMARTDRV 2048");
  delay(250);
  Serial.println("Disk cache activated: 2048 bytes");
  delay(200);
  Serial.println();
  Serial.println("AUTOEXEC.BAT complete.");
  delay(300);
  Serial.println();
}

void loop() {
  Serial.print("C:\\> ");
  inputBuffer = "";
  while (true) {
    if (Serial.available()) {
      char c = Serial.read();
      if (c == '\n' || c == '\r') {
        Serial.println();
        processCommand(inputBuffer);
        break;
      }
      if (c == 8) {
        if (inputBuffer.length() > 0) {
          inputBuffer.remove(inputBuffer.length() - 1);
          Serial.print("\b \b");
        }
      } else if (c >= 32 && c <= 126 && inputBuffer.length() < 80) {
        inputBuffer += c;
        Serial.print(c);
      }
    }
  }
}

void processCommand(String cmd) {
  cmd.trim();
  if (cmd.length() == 0) return;
  String upper = cmd;
  upper.toUpperCase();

  if (upper == "VER") {
    Serial.println();
    Serial.println("ES-DOS 1.0  [Version 1.00.000]");
    Serial.println("(C) 2026 Espressif Micro Systems. All rights reserved.");
    Serial.println();
    return;
  }

  if (upper == "DEVICE" || upper == "INFO") {
    Serial.println();
    Serial.println("--- System Information ---");
    Serial.println("Device Model : " + String(ESP.getChipModel()));
    Serial.print("Chip Revision: ");
    Serial.println(ESP.getChipRevision());
    Serial.print("CPU Cores    : ");
    Serial.println(ESP.getChipCores());
    Serial.print("CPU Speed    : 240 MHz");
    Serial.println();
    Serial.print("Flash Size   : ");
    Serial.print(ESP.getFlashChipSize() / 1024);
    Serial.println(" KB");
    Serial.print("Flash Speed : ");
    Serial.print(ESP.getFlashChipSpeed() / 1000000);
    Serial.println(" MHz");
    Serial.print("Free RAM     : ");
    Serial.print(ESP.getFreeHeap() / 1024);
    Serial.println(" KB");
    Serial.println("OS           : ES-DOS 1.0");
    Serial.println("WiFi Module  : ESP32 Internal (2.4 GHz)");
    Serial.println("--------------------------");
    Serial.println();
    return;
  }

  if (upper == "HELP") {
    Serial.println();
    Serial.println("Available commands:");
    Serial.println();
    Serial.println("  WIFI      Scan and display nearby WiFi networks");
    Serial.println("  INFO      Show hardware and system information");
    Serial.println("  DEVICE    Same as INFO");
    Serial.println("  VER       Display ES-DOS version");
    Serial.println("  TIME      Show current system uptime");
    Serial.println("  DATE      Show system date");
    Serial.println("  DIR       List files in current directory");
    Serial.println("  CLS       Clear screen");
    Serial.println("  ECHO      Display a message");
    Serial.println("  LED ON    Turn on status LED");
    Serial.println("  LED OFF   Turn off status LED");
    Serial.println("  MEM       Show memory status");
    Serial.println("  REBOOT    Restart the system");
    Serial.println("  HELP      Display this help screen");
    Serial.println();
    return;
  }

  if (upper == "CLS") {
    for (int i = 0; i < 40; i++) Serial.println();
    return;
  }

  if (upper == "DIR") {
    Serial.println();
    Serial.println(" Volume in drive C is ESDOS");
    Serial.println(" Directory of C:\\");
    Serial.println();
    Serial.println("COMMAND  COM      8192  01-01-2026   3:14a");
    Serial.println("AUTOEXEC BAT       128  01-01-2026   3:14a");
    Serial.println("CONFIG   SYS       256  01-01-2026   3:14a");
    Serial.println("SMARTDRV EXE      2048  01-01-2026   3:14a");
    Serial.println("WIFI     EXE      4096  01-01-2026   3:14a");
    Serial.println("LED      EXE       512  01-01-2026   3:14a");
    Serial.println("        6 file(s)     15,232 bytes");
    Serial.println("                   477,184 bytes free");
    Serial.println();
    return;
  }

  if (upper == "TIME") {
    unsigned long up = (millis() - bootTime) / 1000;
    int h = up / 3600;
    int m = (up % 3600) / 60;
    int s = up % 60;
    Serial.println();
    Serial.print("System uptime: ");
    if (h < 10) Serial.print("0");
    Serial.print(h);
    Serial.print(":");
    if (m < 10) Serial.print("0");
    Serial.print(m);
    Serial.print(":");
    if (s < 10) Serial.print("0");
    Serial.print(s);
    Serial.println();
    Serial.println();
    return;
  }

  if (upper == "DATE") {
    Serial.println();
    Serial.println("Current date: Sat 09-12-2026");
    Serial.println("(No RTC module detected - date is static)");
    Serial.println();
    return;
  }

  if (upper == "MEM") {
    Serial.println();
    Serial.println("Memory Status:");
    Serial.println();
    Serial.print("  Free Heap : ");
    Serial.print(ESP.getFreeHeap());
    Serial.println(" bytes");
    Serial.print("  Min Heap  : ");
    Serial.print(ESP.getMinFreeHeap());
    Serial.println(" bytes");
    Serial.print("  Flash Size: ");
    Serial.print(ESP.getFlashChipSize());
    Serial.println(" bytes");
    Serial.print("  Sketch    : ");
    Serial.print(ESP.getSketchSize());
    Serial.println(" bytes");
    Serial.println();
    return;
  }

  if (upper.startsWith("ECHO ")) {
    Serial.println(cmd.substring(5));
    Serial.println();
    return;
  }
  if (upper == "ECHO") {
    Serial.println("ECHO is on.");
    Serial.println();
    return;
  }

  if (upper == "LED ON") {
    digitalWrite(LED, HIGH);
    Serial.println("Status LED: ON");
    Serial.println();
    return;
  }
  if (upper == "LED OFF") {
    digitalWrite(LED, LOW);
    Serial.println("Status LED: OFF");
    Serial.println();
    return;
  }

  if (upper == "WIFI") {
    Serial.println();
    Serial.println("Scanning WiFi networks. Please wait...");
    WiFi.disconnect(true);
    delay(100);
    int n = WiFi.scanNetworks();
    Serial.println();
    if (n == 0) {
      Serial.println("No wireless networks found.");
      Serial.println();
      return;
    }
    Serial.print("Found ");
    Serial.print(n);
    Serial.println(" network(s):");
    Serial.println();
    Serial.println("SSID                           RSSI  CH  SECURITY");
    Serial.println("------------------------------ ----- --- --------");
    for (int i = 0; i < n; i++) {
      String ssid = WiFi.SSID(i);
      if (ssid.length() == 0) ssid = "(hidden)";
      while (ssid.length() < 30) ssid += " ";
      String rssi = String(WiFi.RSSI(i));
      while (rssi.length() < 5) rssi = " " + rssi;
      String ch = String(WiFi.channel(i));
      while (ch.length() < 3) ch = " " + ch;
      String sec = "";
      switch (WiFi.encryptionType(i)) {
        case WIFI_AUTH_OPEN: sec = "OPEN"; break;
        case WIFI_AUTH_WEP: sec = "WEP"; break;
        case WIFI_AUTH_WPA_PSK: sec = "WPA"; break;
        case WIFI_AUTH_WPA2_PSK: sec = "WPA2"; break;
        case WIFI_AUTH_WPA_WPA2_PSK: sec = "WPA/WPA2"; break;
        case WIFI_AUTH_WPA3_PSK: sec = "WPA3"; break;
        default: sec = "UNKNOWN"; break;
      }
      Serial.println(ssid + " " + rssi + " " + ch + "  " + sec);
    }
    Serial.println();
    WiFi.scanDelete();
    return;
  }

  if (upper == "REBOOT") {
    Serial.println();
    Serial.println("Restarting system...");
    Serial.println();
    delay(800);
    ESP.restart();
    return;
  }

  Serial.println();
  Serial.print("Bad command or file name: ");
  Serial.println(cmd);
  Serial.println();
}
